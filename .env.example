# Provider selection — gemini for dev, amd for demo day
PROVIDER=gemini

# Gemini development mode
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Primary vision — AMD-provided hackathon endpoint (fill in on demo day)
PRIMARY_VISION_URL=https://<amd-endpoint>/v1
PRIMARY_VISION_KEY=<amd-api-key>
PRIMARY_VISION_MODEL=<amd-hosted-vlm-model>
PRIMARY_VISION_PROVIDER=AMD_MI300X

# Puter fallback (local dev resilience only — do NOT use during demo)
PUTER_AUTH_TOKEN=
PUTER_MODEL=qwen/qwen2.5-vl-72b-instruct

# Bridge URL used by ui/app.py to call cloud_brain.py
MIMIQ_STEP_GENERATOR_URL=http://127.0.0.1:8000/playbook

# Bridge port override (default 8000)
CLOUD_BRAIN_PORT=8000
