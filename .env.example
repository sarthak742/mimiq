# Provider selection
PROVIDER=gemini

# Gemini development mode
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Primary vision provider, used for AMD / NVIDIA NIM demo mode
PRIMARY_VISION_URL=
PRIMARY_VISION_KEY=
PRIMARY_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
PRIMARY_VISION_PROVIDER=

# Backward-compatible NVIDIA aliases
NVIDIA_API_BASE=
NVIDIA_API_KEY=

# Puter fallback
PUTER_AUTH_TOKEN=
PUTER_MODEL=qwen/qwen2.5-vl-72b-instruct

# Bridge URL used by the future UI server to call cloud_brain.py
MIMIQ_STEP_GENERATOR_URL=http://127.0.0.1:8000/playbook

# Optional bridge port override
CLOUD_BRAIN_PORT=8000
